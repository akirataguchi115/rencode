{
  "manifest_version": 2,
  "name": "ffmpeg.wasm demo",
  "version": "1.0.1",
  "description": "ffmpeg.wasm demo",
  "permissions": [
      "<all_urls>",
      "contextMenus",
      "downloads",
      "activeTab"
  ],
  "background": {
      "scripts": [
          "background-script.js"
      ]
  },
  "content_scripts": [
      {
          "matches": [
              "<all_urls>"
          ],
          "js": [
              "lib/ffmpeg.js",
              "lib/index.js"
          ]
      }
  ],
  "web_accessible_resources": [
      "lib/*"
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
}